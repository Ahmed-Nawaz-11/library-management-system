{
  "info": {
    "name": "Library Management System",
    "description": "How to use: Simply hit the Login endpoint with valid credentials. Postman will automatically store the secure access and refresh cookies in its Cookie Jar and attach them to all subsequent requests automatically.\nThree test accounts: admin_user/Admin@1234, librarian1/Lib@1234, ahmad_member/Test@1234\nBase URL is http://127.0.0.1:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "FOLDER 1 — Authentication",
      "item": [
        {
          "name": "Register new member",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ahmad_member\",\n  \"email\": \"ahmad@test.com\",\n  \"password\": \"Test@1234\",\n  \"phone\": \"03001234567\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {"raw": "{{base_url}}/api/auth/register/"}
          }
        },
        {
          "name": "Login with username",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ahmad_member\",\n  \"password\": \"Test@1234\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {"raw": "{{base_url}}/api/auth/login/"}
          }
        },
        {
          "name": "Login with email",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmad@test.com\",\n  \"password\": \"Test@1234\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {"raw": "{{base_url}}/api/auth/login/"}
          }
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {"raw": "{{base_url}}/api/auth/refresh/"}
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {"raw": "{{base_url}}/api/auth/logout/"}
          }
        },
        {
          "name": "View own profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{base_url}}/api/auth/profile/"}
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"03009999999\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {"raw": "{{base_url}}/api/auth/profile/"}
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"Test@1234\",\n  \"new_password\": \"NewPass@5678\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {"raw": "{{base_url}}/api/auth/change-password/"}
          }
        }
      ]
    },
